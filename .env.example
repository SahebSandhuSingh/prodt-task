# Environment Configuration for Travel Booking Prototype

# PostgreSQL Database Connection URL
# For local dev outside Docker: postgresql+asyncpg://postgres:postgres@localhost:5433/travel_booking
# For Docker Compose environment: postgresql+asyncpg://postgres:postgres@postgres:5432/travel_booking
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/travel_booking

# Temporal Server Host:Port
# For local dev outside Docker: localhost:7233
# For Docker Compose environment: temporal:7233
TEMPORAL_HOST=localhost:7233

# FastAPI Web Server Port
PORT=8000
